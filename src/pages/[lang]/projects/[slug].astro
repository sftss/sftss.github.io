---
import Base from '../../../layouts/Base.astro';
import { langs, useTranslations, type Lang } from '../../../i18n/ui';
import { projectSlugs } from '../../../lib/projects';

export const getStaticPaths = () =>
  langs.flatMap((lang) => projectSlugs.map((slug) => ({ params: { lang, slug } })));

const lang = Astro.params.lang as Lang;
const { slug } = Astro.params;
const t = useTranslations(lang);
---

<Base lang={lang} path={`projects/${slug}/`} title={`${slug} | Sefer Tasdemir`} noindex>
  <section class="container">
    <h1>{slug}</h1>
    <p>{t('stub.project')}</p>
    <p><a href={`/${lang}/`}>{t('footer.back')}</a></p>
  </section>
</Base>

<style>
  section {
    padding-block: var(--space-xl);
  }
</style>
