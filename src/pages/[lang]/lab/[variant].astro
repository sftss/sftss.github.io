---
// Pages de comparaison des heros, à supprimer une fois le choix fait.
import HeroAscii from '../../../components/HeroAscii.astro';
import HeroPixels from '../../../components/HeroPixels.astro';
import HeroScroll from '../../../components/HeroScroll.astro';
import HomeSections from '../../../components/HomeSections.astro';
import { langs, type Lang } from '../../../i18n/ui';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = () =>
  langs.flatMap((lang) => ['a', 'b', 'c'].map((variant) => ({ params: { lang, variant } })));

const lang = Astro.params.lang as Lang;
const { variant } = Astro.params;
const Hero = { a: HeroAscii, b: HeroPixels, c: HeroScroll }[variant as 'a' | 'b' | 'c'];
---

<Base lang={lang} path={`lab/${variant}/`} title={`Hero ${variant.toUpperCase()} | Sefer Tasdemir`} noindex>
  <Hero lang={lang} />
  <HomeSections lang={lang} />
</Base>
