---
import HeroAscii from '../../components/HeroAscii.astro';
import HomeSections from '../../components/HomeSections.astro';
import Midwater from '../../components/Midwater.astro';
import ReefSchool from '../../components/ReefSchool.astro';
import SharkPass from '../../components/SharkPass.astro';
import { langs, type Lang } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
---

<Base lang={lang}>
  <ReefSchool />
  <HeroAscii lang={lang} />
  <HomeSections lang={lang} />
  <Midwater />
  <SharkPass />
</Base>
