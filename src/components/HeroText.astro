---
import { useTranslations, type Lang } from '../i18n/ui';
import CvLink from './CvLink.astro';

const { lang, onDark = false } = Astro.props as { lang: Lang; onDark?: boolean };
const t = useTranslations(lang);
---

<div class:list={['hero-text', { 'on-dark': onDark }]}>
  <h1>Sefer<br />Tasdemir</h1>
  <p class="role">{t('hero.title')}</p>
  <p class="tagline">{t('hero.tagline')}</p>
  <p class="status">{t('hero.status')}</p>
  <div class="actions">
    <a class="btn btn-primary" href="#projects">{t('hero.projects')}</a>
    <CvLink class="btn" lang={lang} label={t('hero.cv')} />
  </div>
  <figure>
    <blockquote lang="en">Program or be programmed.</blockquote>
    <figcaption>Douglas Rushkoff</figcaption>
  </figure>
</div>

<style>
  h1 {
    font-size: clamp(3rem, 1.6rem + 6.4vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  .role {
    margin: var(--space-s) 0 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .tagline {
    margin: var(--space-m) 0 0;
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.25;
  }

  .status {
    max-width: 40rem;
    margin: var(--space-s) 0 0;
    color: var(--color-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  figure {
    margin: var(--space-l) 0 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  blockquote {
    margin: 0;
    font-style: italic;
  }

  .on-dark,
  .on-dark .status,
  .on-dark figure {
    color: var(--color-on-scrim);
  }

  .on-dark .role {
    color: var(--color-on-scrim);
  }
</style>
