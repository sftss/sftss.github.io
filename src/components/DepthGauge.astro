---
// Profondimètre : la progression de lecture affichée comme une profondeur de plongée.
// Décoratif (aria-hidden) : il double la barre de progression du header.
import { useTranslations, type Lang } from '../i18n/ui';
import { formatDepth, ZONES } from '../lib/depth';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const zones = Object.fromEntries(ZONES.map((zone) => [zone, t(`depth.${zone}`)]));
---

<span class="gauge" aria-hidden="true" data-depth-gauge data-lang={lang} data-zones={JSON.stringify(zones)}>
  <span class="zone" data-zone>{zones.epipelagic}</span>
  <span class="meters" data-meters>{formatDepth(0, lang)}</span>
</span>

<style>
  .gauge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6em;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    white-space: nowrap;
    user-select: none;
  }

  /* Largeur fixe : le header ne bouge pas quand le nombre de chiffres change. */
  .meters {
    display: inline-block;
    min-width: 8ch;
    color: var(--color-accent-2);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .zone {
    font-size: 0.85em;
    opacity: 0.8;
  }

  @media (max-width: 75rem) {
    .zone {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .gauge {
      display: none;
    }
  }
</style>

<script>
  import { onPage } from '../lib/lifecycle';
  import { depthAt, formatDepth, zoneAt } from '../lib/depth';

  onPage(() => {
    const gauge = document.querySelector<HTMLElement>('[data-depth-gauge]');
    const meters = gauge?.querySelector<HTMLElement>('[data-meters]');
    const zone = gauge?.querySelector<HTMLElement>('[data-zone]');
    if (!gauge || !meters || !zone) return;
    const lang = gauge.dataset.lang ?? 'fr';
    const zones: Record<string, string> = JSON.parse(gauge.dataset.zones ?? '{}');

    let frame = 0;
    let shown = -1;
    const update = () => {
      frame = 0;
      const root = document.documentElement;
      const depth = depthAt(scrollY / Math.max(1, root.scrollHeight - innerHeight));
      if (depth === shown) return;
      shown = depth;
      meters.textContent = formatDepth(depth, lang);
      zone.textContent = zones[zoneAt(depth)] ?? '';
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule, { passive: true });
    return () => {
      cancelAnimationFrame(frame);
      removeEventListener('scroll', schedule);
      removeEventListener('resize', schedule);
    };
  });
</script>
