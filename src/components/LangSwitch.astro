---
import { langs, useTranslations, type Lang } from '../i18n/ui';

const { lang, path = '' } = Astro.props as { lang: Lang; path?: string };
const t = useTranslations(lang);
---

<ul class="lang-switch" aria-label={t('lang.label')}>
  {
    langs.map((code) => (
      <li>
        <a
          href={`/${code}/${path}`}
          hreflang={code}
          lang={code}
          data-lang={code}
          data-astro-history="replace"
          aria-label={`${code.toUpperCase()}, ${useTranslations(code)('lang.switch')}`}
          aria-current={code === lang ? 'true' : undefined}
        >
          {code.toUpperCase()}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .lang-switch {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  a {
    display: inline-block;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius);
    color: var(--color-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text);
  }

  a[aria-current] {
    color: var(--color-text);
    font-weight: 600;
  }
</style>

<script>
  // Le texte FR et le texte EN n'ont pas la même longueur : on retient la section à l'écran
  // et la position dans cette section, puis on la retrouve dans l'autre langue.
  let anchor: { id: string; ratio: number; y: number } | null = null;

  const currentAnchor = () => {
    let section: HTMLElement | null = null;
    for (const candidate of document.querySelectorAll<HTMLElement>('main section[id]')) {
      if (candidate.getBoundingClientRect().top <= innerHeight / 2) section = candidate;
    }
    if (!section) return { id: '', ratio: 0, y: scrollY };
    const box = section.getBoundingClientRect();
    return { id: section.id, ratio: -box.top / Math.max(1, box.height), y: scrollY };
  };

  // Capture : on note la position avant que le routeur ne prenne le clic.
  document.addEventListener(
    'click',
    (event: MouseEvent) => {
      // Le routeur laisse passer ces clics (nouvel onglet, sélection...) : rien à retenir.
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('.lang-switch a');
      if (!link) return;
      try {
        localStorage.setItem('preferredLanguage', link.dataset.lang ?? '');
      } catch {}
      anchor = currentAnchor();
    },
    true,
  );

  document.addEventListener('astro:after-swap', () => {
    if (!anchor) return;
    const { id, ratio, y } = anchor;
    anchor = null;
    const section = id ? document.getElementById(id) : null;
    const top = section ? section.getBoundingClientRect().top + scrollY + ratio * section.offsetHeight : y;
    scrollTo({ top, behavior: 'instant' });
    // Le clic a détruit l'élément focalisé avec l'ancienne page : le focus passe au lien de la nouvelle.
    document.querySelector<HTMLAnchorElement>('.lang-switch a[aria-current]')?.focus({ preventScroll: true });
  });
</script>
