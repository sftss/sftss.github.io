---
import { home } from '../i18n/home';
import type { Lang } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const copy = home[lang].ai;
---

<section id="claude-code" class="section container">
  <h2>
    {copy.title.split('{brand}')[0]}<span class="claude">Claude Code</span>{copy.title.split('{brand}')[1]}
  </h2>
  <p class="lead">{copy.lead}</p>
  <ul class="cards">
    {
      copy.items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          {item.stat && <p class="stat">{item.stat}</p>}
          <ul class="tags">
            {item.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          {item.href && (
            <a href={item.href} rel="noopener noreferrer">
              {item.linkLabel ?? copy.repo}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-m);
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }

  .cards > li {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .claude {
    color: var(--color-claude);
  }

  h3 {
    font-size: var(--step-1);
  }

  .cards p {
    flex: 1;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .cards .stat {
    flex: none;
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .cards a {
    font-size: var(--step--1);
  }
</style>
