---
import type { Lang } from '../i18n/ui';
import { asciiPortrait } from '../lib/ascii';
import HeroText from './HeroText.astro';

const { lang } = Astro.props as { lang: Lang };
const portrait = await asciiPortrait({ cols: 110, threshold: 0.3, gamma: 0.8 });
const cue = lang === 'fr' ? 'Défiler' : 'Scroll';
---

<section class="hero" data-hero>
  <div class="container grid">
    <HeroText lang={lang} />
    <div class="frame">
      <pre aria-hidden="true" data-ascii data-cols={Math.max(...portrait.map((line) => line.length))}>{portrait.join('\n')}</pre>
    </div>
  </div>
  <a class="cue" href="#skills">{cue} ↓</a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: calc(100svh - 4.5rem);
    padding-block: var(--space-l);
    overflow: hidden;
  }

  .grid {
    display: grid;
    align-items: center;
    gap: var(--space-l);
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }

  .frame {
    position: relative;
    container-type: inline-size;
    order: -1;
    touch-action: pan-y;
  }

  @media (min-width: 60rem) {
    .frame {
      order: 0;
    }
  }

  pre {
    margin: 0;
    /* 110 colonnes de caractères mono, d'environ 0,6 em de large chacune. */
    font-size: calc(100cqi / 110 / 0.6);
    line-height: 1;
    font-family: var(--font-mono);
    color: var(--color-accent);
    white-space: pre;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Le script dessine le portrait dans un canvas posé exactement sur le texte. */
  .frame :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cue {
    position: absolute;
    bottom: var(--space-s);
    left: 50%;
    translate: -50% 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .cue:hover {
    color: var(--color-text);
  }
</style>

<script>
  interface Particle {
    ch: string;
    col: number;
    row: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    heat: number;
    tint: number;
    revealAt: number;
    sx: number;
    sy: number;
  }

  const pre = document.querySelector<HTMLPreElement>('[data-ascii]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Sans JS ou en mouvement réduit, le <pre> statique reste affiché tel quel.
  if (pre && hero && !reduced) {
    const glyphs = '01/\\{}[]=+*#%@$?!';
    const palettes = {
      dark: ['oklch(0.9 0.12 215)', 'oklch(0.97 0.01 250)', 'oklch(0.8 0.16 350)', 'oklch(0.88 0.15 90)'],
      light: ['oklch(0.55 0.13 215)', 'oklch(0.42 0.06 262)', 'oklch(0.58 0.2 350)', 'oklch(0.62 0.16 65)'],
    };
    const canvas = document.createElement('canvas');
    canvas.setAttribute('aria-hidden', 'true');
    pre.after(canvas);
    pre.style.visibility = 'hidden';
    const ctx = canvas.getContext('2d')!;
    const start = performance.now();

    const particles: Particle[] = [];
    pre.textContent!.split('\n').forEach((line, row) =>
      [...line].forEach((ch, col) => {
        if (ch === ' ') return;
        const angle = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.4;
        const distance = 220 + Math.random() * 520;
        particles.push({
          ch, col, row, x: 0, y: 0, vx: 0, vy: 0, heat: 0,
          tint: Math.floor(Math.random() * 4),
          revealAt: Math.random() * 1200,
          sx: Math.cos(angle) * distance,
          sy: Math.sin(angle) * distance,
        });
      }),
    );

    let charWidth = 0;
    let lineHeight = 0;
    let font = '';
    let width = 0;
    let height = 0;
    let placed = false;
    let pointer: { x: number; y: number } | null = null;
    let scatter = 0;
    let frame = 0;

    const homeX = (p: Particle) => (p.col + 0.5) * charWidth;
    const homeY = (p: Particle) => (p.row + 0.5) * lineHeight;

    const layout = () => {
      const style = getComputedStyle(pre);
      const size = parseFloat(style.fontSize);
      const ratio = devicePixelRatio || 1;
      width = pre.clientWidth;
      height = pre.clientHeight;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      font = `${size}px ${style.fontFamily}`;
      ctx.font = font;
      charWidth = ctx.measureText('M').width;
      lineHeight = size;
      if (!placed) {
        particles.forEach((p) => {
          p.x = homeX(p);
          p.y = homeY(p);
        });
        placed = true;
      }
    };

    const step = (now: number) => {
      const intro = now - start < 1300;
      const radius = charWidth * 9;
      const easedScatter = scatter ** 1.5;
      let busy = intro || pointer !== null;

      for (const p of particles) {
        const tx = homeX(p) + p.sx * easedScatter;
        const ty = homeY(p) + p.sy * easedScatter;
        let fx = (tx - p.x) * 0.08;
        let fy = (ty - p.y) * 0.08;
        if (pointer) {
          const dx = p.x - pointer.x;
          const dy = p.y - pointer.y;
          const d = Math.hypot(dx, dy);
          // « Trou noir » : les caractères proches du curseur s'écartent et prennent une couleur.
          if (d < radius) {
            const force = (1 - d / radius) * 3.2;
            fx += (dx / (d || 1)) * force;
            fy += (dy / (d || 1)) * force;
            p.heat = Math.max(p.heat, 1 - d / radius);
          }
        }
        p.heat = Math.max(p.heat * 0.965, scatter);
        p.vx = (p.vx + fx) * 0.8;
        p.vy = (p.vy + fy) * 0.8;
        p.x += p.vx;
        p.y += p.vy;
        if (!busy && (Math.abs(p.vx) + Math.abs(p.vy) > 0.03 || p.heat > 0.03)) busy = true;
      }
      return busy;
    };

    const draw = (now: number) => {
      const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const palette = palettes[theme];
      ctx.clearRect(0, 0, width, height);
      ctx.font = font;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.globalAlpha = 1 - scatter * 0.85;
      // Couleur de base d'abord, puis une passe par couleur : peu de changements de style par image.
      for (let pass = -1; pass < palette.length; pass++) {
        ctx.fillStyle = pass === -1 ? getComputedStyle(pre).color : palette[pass];
        for (const p of particles) {
          const hidden = now - start < p.revealAt;
          const colored = hidden || p.heat > 0.12;
          if (pass === -1 ? colored : !colored || p.tint !== pass) continue;
          const ch = hidden || p.heat > 0.6 ? glyphs[(Math.random() * glyphs.length) | 0] : p.ch;
          ctx.fillText(ch, p.x, p.y);
        }
      }
    };

    const tick = (now: number) => {
      const busy = step(now);
      draw(now);
      // La boucle s'arrête dès que tout est revenu au repos.
      frame = busy ? requestAnimationFrame(tick) : 0;
    };
    const wake = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };

    layout();
    wake();
    new ResizeObserver(() => {
      layout();
      wake();
    }).observe(pre);

    canvas.addEventListener('pointermove', (event) => {
      const box = canvas.getBoundingClientRect();
      pointer = { x: event.clientX - box.left, y: event.clientY - box.top };
      wake();
    });
    canvas.addEventListener('pointerleave', () => {
      pointer = null;
    });

    // Au défilement, le portrait se désagrège vers le haut pendant que le hero quitte l'écran.
    addEventListener(
      'scroll',
      () => {
        const box = hero.getBoundingClientRect();
        const next = Math.min(1, Math.max(0, -box.top / (box.height * 0.85)));
        if (next !== scatter) {
          scatter = next;
          wake();
        }
      },
      { passive: true },
    );
    new MutationObserver(wake).observe(document.documentElement, { attributeFilter: ['data-theme'] });
  }
</script>
