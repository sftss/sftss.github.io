---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  embeds: { title: string; url: string }[];
}

const { lang, embeds } = Astro.props;
const t = useTranslations(lang);
---

{
  embeds.length > 0 && (
    <div class="embeds">
      {embeds.map((embed) => (
        <figure>
          <div class="frame" data-embed={embed.url} data-title={embed.title}>
            <button class="btn" type="button">
              {t('embed.load')}
            </button>
            <p>{t('embed.note')}</p>
          </div>
          <figcaption>
            {embed.title}.{' '}
            <a href={embed.url} rel="noopener noreferrer">
              {t('embed.open')}
            </a>
          </figcaption>
        </figure>
      ))}
    </div>
  )
}

<style>
  .embeds {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  figure {
    margin: 0;
  }

  .frame {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-xs);
    aspect-ratio: 16 / 10;
    padding: var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    text-align: center;
  }

  .frame p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .frame button {
    background: transparent;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .frame:has(iframe) {
    display: block;
    padding: 0;
    overflow: hidden;
  }

  .frame :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Sans JS, le bouton ne peut rien charger : il reste le lien sous le cadre. */
  :global(html:not([data-theme])) .frame button {
    display: none;
  }

  figcaption {
    margin-top: var(--space-xs);
    color: var(--color-muted);
    font-size: var(--step--1);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-embed]').forEach((frame) => {
    frame.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = frame.dataset.embed ?? '';
      iframe.title = frame.dataset.title ?? '';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
