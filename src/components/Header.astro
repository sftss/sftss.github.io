---
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import CvLink from './CvLink.astro';

const { lang, path = '' } = Astro.props as { lang: Lang; path?: string };
const t = useTranslations(lang);
const home = `/${lang}/`;
const items = [
  { href: `${home}#projects`, label: t('nav.projects') },
  { href: `${home}#experience`, label: t('nav.experience') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="site-header">
  <a class="skip" href="#main">{t('skip')}</a>
  <div class="container bar">
    <a class="brand" href={home}>Sefer Tasdemir</a>
    <nav aria-label={t('nav.label')}>
      <ul>
        {items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><CvLink lang={lang} label={t('nav.cv')} /></li>
      </ul>
    </nav>
    <div class="tools">
      <LangSwitch lang={lang} path={path} />
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-bg) 82%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  /* Progression de lecture, en CSS pur. Firefox ne gère pas encore scroll() : pas de barre. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header::after {
        content: '';
        position: absolute;
        inset-inline: 0;
        bottom: -1px;
        height: 2px;
        background: var(--color-accent);
        transform: scaleX(0);
        transform-origin: left;
        animation: read-progress linear both;
      }

      /* Règle à part, plus spécifique : le minifieur fusionnerait sinon la timeline dans le
         raccourci animation, que Chrome refuse. */
      .site-header.site-header::after {
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes read-progress {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
    padding-block: var(--space-s);
  }

  .brand {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    margin-inline-start: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* :global pour inclure le lien CV, rendu par le composant CvLink. */
  nav :global(a) {
    color: var(--color-muted);
    font-size: var(--step--1);
    text-decoration: none;
  }

  nav :global(a:hover) {
    color: var(--color-text);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  @media (max-width: 44rem) {
    .bar {
      padding-block: var(--space-xs);
    }

    .tools {
      margin-inline-start: auto;
    }

    nav {
      order: 3;
      flex-basis: 100%;
      margin-inline-start: 0;
    }
  }
</style>

<script>
  import { onPage } from '../lib/lifecycle';

  // La hauteur du header sert aux ancres (scroll-padding-top) et au hero figé.
  onPage(() => {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    const observer = new ResizeObserver(() =>
      document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`),
    );
    observer.observe(header);
    return () => observer.disconnect();
  });
</script>
