---
import { home } from '../i18n/home';
import type { Lang } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const copy = home[lang].experience;
---

<section id="experience" class="section container">
  <div class="columns">
    <div>
      <h2>{copy.work}</h2>
      <ol>
        {
          copy.jobs.map((job) => (
            <li>
              <h3>{job.title}</h3>
              <p class="meta">
                {job.place} · {job.dates}
              </p>
              <ul>
                {job.points.map((point) => <li>{point}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
    <div>
      <h2>{copy.education}</h2>
      <ol>
        {
          copy.degrees.map((degree) => (
            <li>
              <h3>{degree.title}</h3>
              <p class="meta">
                {degree.place} · {degree.dates}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 56rem) {
    .columns {
      grid-template-columns: 3fr 2fr;
    }
  }

  ol {
    display: grid;
    gap: var(--space-m);
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    font-size: var(--step-0);
    line-height: 1.3;
  }

  .meta {
    margin: 0.2rem 0 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  ol ul {
    margin: var(--space-xs) 0 0;
    padding-inline-start: 1.2em;
    color: var(--color-muted);
    font-size: var(--step--1);
  }
</style>
