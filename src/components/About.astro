---
import { home } from '../i18n/home';
import { useTranslations, type Lang } from '../i18n/ui';
import { parseRich, words } from '../lib/rich';
import Contributions from './Contributions.astro';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const copy = home[lang].about;
// Chaque mot est entouré au build (<span class="w">) : le CSS l'allume au défilement, sans JavaScript.
const paragraphs = copy.paragraphs.map((paragraph) =>
  parseRich(paragraph).map((part) => ({
    keyword: part.keyword,
    claude: part.text === 'Claude Code',
    words: words(part.text).map((text) => ({ text, space: text.trim() === '' })),
  })),
);
---

<section id="about" class="section container">
  <h2>{t('nav.about')}</h2>
  <div class="story">
    {
      paragraphs.map((parts) => (
        <p>
          {parts.map((part) =>
            part.keyword ? (
              <strong class:list={['kw', { claude: part.claude }]}>
                {part.words.map((word) => (word.space ? word.text : <span class="w">{word.text}</span>))}
              </strong>
            ) : (
              part.words.map((word) => (word.space ? word.text : <span class="w">{word.text}</span>))
            ),
          )}
        </p>
      ))
    }
  </div>
  <dl>
    {
      copy.facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>
  <Contributions lang={lang} />
</section>

<style>
  /* Même gabarit que les textes d'introduction des autres sections (.lead). */
  .story {
    max-width: 46rem;
    margin-top: var(--space-s);
  }

  .story p {
    margin: 0 0 var(--space-s);
    color: var(--color-muted);
  }

  .kw {
    color: var(--color-accent);
    font-weight: 600;
  }

  .kw.claude {
    color: var(--color-claude);
  }

  /* Le texte s'allume ligne à ligne en entrant dans l'écran. Sans support
     (Firefox aujourd'hui) ou en mouvement réduit, il s'affiche normalement. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .w {
        animation: light linear both;
      }

      /* Règle à part, plus spécifique : le minifieur fusionnerait sinon la timeline dans le
         raccourci animation, que Chrome refuse. */
      .story .w {
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
    }
  }

  @keyframes light {
    from {
      opacity: 0.25;
    }

    to {
      opacity: 1;
    }
  }

  dl {
    display: grid;
    gap: var(--space-xs);
    max-width: 46rem;
    margin: var(--space-m) 0 0;
  }

  dl div {
    display: grid;
    gap: 0 var(--space-m);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 40rem) {
    dl div {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  dt {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  dd {
    margin: 0;
  }
</style>
