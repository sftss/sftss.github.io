---
// Easter egg : de temps en temps, un requin ASCII traverse l'accueil, derrière le contenu. Il nage
// dans la page, là où l'on se trouve à son arrivée : en défilant, on le laisse derrière soi.
---

<canvas class="shark-pass" aria-hidden="true" data-shark-pass></canvas>

<style>
  .shark-pass {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: -1;
    width: 100%;
    height: 70vh;
    opacity: 0.45;
    pointer-events: none;
    color: var(--color-muted);
    font-family: var(--font-mono);
  }

  /* Sans le curseur personnalisé, une main au-dessus du requin. */
  :global(html[data-shark-hover]:not(.has-cursor) body) {
    cursor: pointer;
  }
</style>

<script>
  import { onPage } from '../lib/lifecycle';
  import { OceanEngine } from '../lib/ocean';

  const between = (min: number, max: number) => (min + Math.random() * (max - min)) * 1000;

  onPage(() => {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-shark-pass]');
    if (!canvas || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let timer = 0;
    let engine: OceanEngine | null = null;

    // Le canvas vit dans <main>, d'où il se place dans la page ; s'il arrive pendant que l'accueil
    // est épinglé à l'écran, il se glisse dans ce bloc épinglé pour en suivre le mouvement.
    const home = { parent: canvas.parentNode!, next: canvas.nextSibling };
    const release = () => {
      if (canvas.parentNode !== home.parent) home.parent.insertBefore(canvas, home.next);
    };

    const later = (min: number, max: number) => {
      timer = window.setTimeout(pass, between(min, max));
    };

    // Le moteur n'existe que le temps d'une traversée : rien ne tourne entre deux passages.
    const pass = () => {
      // Mouvement réduit activé depuis le dernier passage : on saute celui-ci.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return later(20, 20);
      if (document.hidden) return later(20, 20);
      // Le canvas se place sur les 70 % bas de l'écran actuel, sans dépasser le bas de son support :
      // le bloc épinglé de l'accueil s'il est à l'écran, sinon la page.
      const pin = document.querySelector<HTMLElement>('[data-hero] .pin');
      const pinBox = pin?.getBoundingClientRect();
      const inPin = !!pin && !!pinBox && pinBox.top <= innerHeight * 0.3 && pinBox.bottom >= innerHeight * 0.7;
      release();
      if (inPin) pin.append(canvas);
      const band = innerHeight * 0.3;
      const room = (inPin ? pin.offsetHeight : document.documentElement.scrollHeight) - canvas.offsetHeight;
      const top = inPin ? band - pinBox.top : scrollY + band;
      canvas.style.top = `${Math.max(0, Math.min(room, top))}px`;
      // « 404 » sur le dos : un indice pour qui cherche la page cachée.
      engine = new OceanEngine(canvas, [{ kind: 'classic', size: 1, label: '404' }], {
        transparent: true,
        interactive: false,
        fishCount: 0,
        // Reflets discrets, dans le gris du texte secondaire, relu à chaque passage pour suivre le thème.
        accents: [getComputedStyle(canvas).color],
        pauseOffscreen: false,
        crossing: { dir: Math.random() < 0.5 ? 1 : -1, duration: 10 + Math.random() * 4 },
        onDone: () => {
          engine?.destroy();
          engine = null;
          release();
          document.documentElement.removeAttribute('data-shark-hover');
          later(20, 20);
        },
      });
    };

    later(20, 20);

    // Le requin se laisse attraper : un clic sur lui (hors lien, bouton ou sélection de texte)
    // mène aux abysses, c'est-à-dire à la page 404. Le curseur s'agrandit quand on le survole.
    const html = document.documentElement;
    const INTERACTIVE = 'a[href], button, input, textarea, select, label, summary, [role="button"], iframe';
    const onShark = (event: PointerEvent | MouseEvent) =>
      !!engine &&
      !(event.target as Element).closest?.(INTERACTIVE) &&
      engine.hitShark(event.clientX, event.clientY);
    const onMove = (event: PointerEvent) => {
      const over = event.pointerType === 'mouse' && onShark(event);
      html.toggleAttribute('data-shark-hover', over);
    };
    const onClick = (event: MouseEvent) => {
      if (!onShark(event) || !getSelection()?.isCollapsed) return;
      location.assign(`/${html.lang}/abysses/`);
    };
    addEventListener('pointermove', onMove, { passive: true });
    addEventListener('click', onClick);

    return () => {
      clearTimeout(timer);
      engine?.destroy();
      engine = null;
      release();
      removeEventListener('pointermove', onMove);
      removeEventListener('click', onClick);
      html.removeAttribute('data-shark-hover');
    };
  });
</script>
