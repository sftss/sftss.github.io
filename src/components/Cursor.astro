---
// Point collé à la souris, anneau qui le suit et traînée de bulles ASCII. Le curseur
// natif n'est masqué qu'une fois le script lancé : sans JS, rien ne change.
---

<div class="cursor" aria-hidden="true" data-cursor transition:persist="cursor">
  <canvas class="trail"></canvas>
  <div class="ring"></div>
  <div class="dot"></div>
</div>

<style>
  .cursor {
    display: none;
  }

  :global(html.has-cursor) .cursor {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
    view-transition-name: cursor;
  }

  .trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ring,
  .dot {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    translate: -50% -50%;
    opacity: 0;
    transition: opacity var(--ease);
  }

  .dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    transition:
      opacity var(--ease),
      width var(--ease),
      height var(--ease);
  }

  .ring {
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--color-accent);
    transition:
      opacity var(--ease),
      width var(--ease),
      height var(--ease),
      border-width var(--ease),
      background-color var(--ease);
  }

  .cursor[data-visible] .dot {
    opacity: 1;
  }

  /* L'anneau n'apparaît que sur un élément cliquable : il s'élargit, se remplit, et le point grossit. */
  .cursor[data-visible][data-hover] .ring {
    opacity: 1;
    width: 56px;
    height: 56px;
    border-width: 2.5px;
    background: color-mix(in oklch, var(--color-accent) 30%, transparent);
  }

  .cursor[data-hover] .dot {
    width: 10px;
    height: 10px;
  }

  /* !important : les boutons déclarent cursor: pointer avec une spécificité plus forte. */
  :global(html.has-cursor),
  :global(html.has-cursor *) {
    cursor: none !important;
  }

  :global(html.has-cursor :is(input, textarea, [contenteditable='true'])) {
    cursor: text !important;
  }

  /* Une boîte de dialogue modale passe au-dessus de tout, curseur compris :
     tant qu'elle est ouverte, on masque le curseur personnalisé et on rend le curseur natif. */
  :global(html.has-cursor:has(dialog:modal)) .cursor {
    display: none;
  }

  :global(html.has-cursor:has(dialog:modal) *) {
    cursor: auto !important;
  }

  :global(html.has-cursor:has(dialog:modal) :is(a, button)) {
    cursor: pointer !important;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-cursor]');

  if (root && matchMedia('(pointer: fine)').matches && matchMedia('(forced-colors: none)').matches) {
    const dot = root.querySelector<HTMLElement>('.dot')!;
    const ring = root.querySelector<HTMLElement>('.ring')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const CLICKABLE = 'a[href], button:not(:disabled), [role="button"], summary, label, select';
    // Champs et iframes gardent leur propre curseur.
    const NATIVE = 'input, textarea, [contenteditable="true"], iframe';

    const html = document.documentElement;
    html.classList.add('has-cursor');
    // Le routeur remplace les attributs de <html> : la page suivante garde la classe.
    document.addEventListener('astro:before-swap', (event) => {
      event.newDocument.documentElement.classList.add('has-cursor');
    });

    // Traînée : une bulle tous les STEP px sur le trajet réel, pour que la trace reste continue
    // même à grande vitesse. Elle vieillit sur place : O, o, °, puis ·, en s'effaçant.
    const canvas = root.querySelector<HTMLCanvasElement>('.trail')!;
    const paint = canvas.getContext('2d')!;
    const STEP = 15;
    const MAX_BUBBLES = 120;
    const bubbles: { x: number; y: number; vx: number; vy: number; born: number; life: number; size: number }[] = [];
    let trailX = NaN;
    let trailY = NaN;
    let color = '';
    let font = '';

    const fit = () => {
      const dpr = devicePixelRatio || 1;
      canvas.width = Math.round(innerWidth * dpr);
      canvas.height = Math.round(innerHeight * dpr);
      paint.setTransform(dpr, 0, 0, dpr, 0, 0);
      paint.textAlign = 'center';
      paint.textBaseline = 'middle';
    };
    fit();
    addEventListener('resize', fit);

    const lay = (px: number, py: number) => {
      if (reduced.matches) return;
      if (Number.isNaN(trailX) || Math.hypot(px - trailX, py - trailY) > 300) {
        trailX = px;
        trailY = py;
        return;
      }
      let dist = Math.hypot(px - trailX, py - trailY);
      while (dist >= STEP) {
        const k = STEP / dist;
        trailX += (px - trailX) * k;
        trailY += (py - trailY) * k;
        dist = Math.hypot(px - trailX, py - trailY);
        bubbles.push({
          x: trailX + (Math.random() - 0.5) * 8,
          y: trailY + (Math.random() - 0.5) * 8,
          vx: (Math.random() - 0.5) * 0.2,
          vy: -(0.2 + Math.random() * 0.3),
          born: performance.now(),
          life: 850 + Math.random() * 250,
          size: 11 + Math.random() * 5,
        });
      }
      if (bubbles.length > MAX_BUBBLES) bubbles.splice(0, bubbles.length - MAX_BUBBLES);
    };

    const drawTrail = (now: number) => {
      paint.clearRect(0, 0, innerWidth, innerHeight);
      if (!bubbles.length) return;
      // Couleur et police relues à chaque image : elles suivent le thème.
      color = getComputedStyle(dot).backgroundColor;
      font = getComputedStyle(document.body).getPropertyValue('--font-mono') || 'ui-monospace, monospace';
      paint.fillStyle = color;
      for (let i = bubbles.length - 1; i >= 0; i--) {
        const bubble = bubbles[i];
        const age = (now - bubble.born) / bubble.life;
        if (age >= 1) {
          bubbles.splice(i, 1);
          continue;
        }
        bubble.x += bubble.vx;
        bubble.y += bubble.vy;
        paint.globalAlpha = (1 - age) * 0.9;
        paint.font = `${bubble.size}px ${font}`;
        paint.fillText(age < 0.25 ? 'O' : age < 0.5 ? 'o' : age < 0.75 ? '°' : '·', bubble.x, bubble.y);
      }
      paint.globalAlpha = 1;
    };

    let x = 0;
    let y = 0;
    let ringX = 0;
    let ringY = 0;
    let frame = 0;

    // La boucle ne tourne que tant que l'anneau n'a pas rejoint le point ou qu'il reste des bulles.
    const render = (now: number) => {
      const follow = reduced.matches ? 1 : 0.2;
      ringX += (x - ringX) * follow;
      ringY += (y - ringY) * follow;
      dot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
      drawTrail(now);
      frame = Math.abs(x - ringX) + Math.abs(y - ringY) > 0.1 || bubbles.length ? requestAnimationFrame(render) : 0;
    };

    addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
        const target = event.target as Element;
        if (target.closest?.(NATIVE)) {
          root.removeAttribute('data-visible');
          trailX = NaN;
          return;
        }
        if (!root.hasAttribute('data-visible')) {
          ringX = event.clientX;
          ringY = event.clientY;
          root.setAttribute('data-visible', '');
        }
        x = event.clientX;
        y = event.clientY;
        root.toggleAttribute('data-hover', !!target.closest?.(CLICKABLE));
        lay(x, y);
        if (!frame) frame = requestAnimationFrame(render);
      },
      { passive: true },
    );

    // L'iframe capte la souris : le parent ne reçoit plus que l'entrée sur l'iframe.
    addEventListener('pointerover', (event) => {
      if ((event.target as Element).closest?.(NATIVE)) {
        root.removeAttribute('data-visible');
        trailX = NaN;
      }
    });
    html.addEventListener('pointerleave', () => {
      root.removeAttribute('data-visible');
      trailX = NaN;
    });
  }
</script>
