---
// Point collé à la souris, anneau qui le suit et ondulations d'eau dans son sillage. Le curseur
// natif n'est masqué qu'une fois le script lancé : sans JS, rien ne change.
---

<div class="cursor" aria-hidden="true" data-cursor transition:persist="cursor">
  <canvas class="trail"></canvas>
  <div class="ring"></div>
  <div class="dot"></div>
</div>

<style>
  .cursor {
    display: none;
  }

  :global(html.has-cursor) .cursor {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
    view-transition-name: cursor;
  }

  .trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ring,
  .dot {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    translate: -50% -50%;
    opacity: 0;
    transition: opacity var(--ease);
  }

  .dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    transition:
      opacity var(--ease),
      width var(--ease),
      height var(--ease);
  }

  .ring {
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--color-accent);
    transition:
      opacity var(--ease),
      width var(--ease),
      height var(--ease),
      border-width var(--ease),
      background-color var(--ease);
  }

  .cursor[data-visible] .dot {
    opacity: 1;
  }

  /* L'anneau n'apparaît que sur un élément cliquable : il s'élargit, se remplit, et le point grossit. */
  .cursor[data-visible][data-hover] .ring {
    opacity: 1;
    width: 56px;
    height: 56px;
    border-width: 2.5px;
    background: color-mix(in oklch, var(--color-accent) 30%, transparent);
  }

  .cursor[data-hover] .dot {
    width: 10px;
    height: 10px;
  }

  /* !important : les boutons déclarent cursor: pointer avec une spécificité plus forte. */
  :global(html.has-cursor),
  :global(html.has-cursor *) {
    cursor: none !important;
  }

  :global(html.has-cursor :is(input, textarea, [contenteditable='true'])) {
    cursor: text !important;
  }

  /* Une boîte de dialogue modale passe au-dessus de tout, curseur compris :
     tant qu'elle est ouverte, on masque le curseur personnalisé et on rend le curseur natif. */
  :global(html.has-cursor:has(dialog:modal)) .cursor {
    display: none;
  }

  :global(html.has-cursor:has(dialog:modal) *) {
    cursor: auto !important;
  }

  :global(html.has-cursor:has(dialog:modal) :is(a, button)) {
    cursor: pointer !important;
  }
</style>

<script>
  import { rippleAt } from '../lib/wave';

  const root = document.querySelector<HTMLElement>('[data-cursor]');

  if (root && matchMedia('(pointer: fine)').matches && matchMedia('(forced-colors: none)').matches) {
    const dot = root.querySelector<HTMLElement>('.dot')!;
    const ring = root.querySelector<HTMLElement>('.ring')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const CLICKABLE = 'a[href], button:not(:disabled), [role="button"], summary, label, select';
    // Champs et iframes gardent leur propre curseur.
    const NATIVE = 'input, textarea, [contenteditable="true"], iframe';

    const html = document.documentElement;
    html.classList.add('has-cursor');
    // Le routeur remplace les attributs de <html> : la page suivante garde la classe.
    document.addEventListener('astro:before-swap', (event) => {
      event.newDocument.documentElement.classList.add('has-cursor');
    });

    // Ondulations : un cercle tous les RIPPLE_EVERY × STEP px sur le trajet réel, pour que la trace
    // reste continue même à grande vitesse. Chaque cercle s'élargit en s'effaçant.
    const canvas = root.querySelector<HTMLCanvasElement>('.trail')!;
    const paint = canvas.getContext('2d')!;
    const STEP = 15;
    const RIPPLE_EVERY = 3;
    const MAX_RIPPLES = 24;
    // Chaque ondulation : un anneau principal, et un second plus petit et plus pâle à l'intérieur.
    const RINGS = [
      { scale: 1, fade: 1 },
      { scale: 0.6, fade: 0.5 },
    ];
    const ripples: { x: number; y: number; born: number; life: number; max: number }[] = [];
    let steps = 0;
    let trailX = NaN;
    let trailY = NaN;

    const fit = () => {
      const dpr = devicePixelRatio || 1;
      canvas.width = Math.round(innerWidth * dpr);
      canvas.height = Math.round(innerHeight * dpr);
      paint.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    fit();
    addEventListener('resize', fit);

    const ripple = (rx: number, ry: number, max: number, life: number) => {
      ripples.push({ x: rx, y: ry, max, life, born: performance.now() });
    };

    const lay = (px: number, py: number) => {
      if (reduced.matches) return;
      if (Number.isNaN(trailX) || Math.hypot(px - trailX, py - trailY) > 300) {
        trailX = px;
        trailY = py;
        return;
      }
      let dist = Math.hypot(px - trailX, py - trailY);
      while (dist >= STEP) {
        trailX += ((px - trailX) / dist) * STEP;
        trailY += ((py - trailY) / dist) * STEP;
        dist = Math.hypot(px - trailX, py - trailY);
        steps++;
        if (steps % RIPPLE_EVERY === 0) ripple(trailX, trailY, 36, 900 + Math.random() * 200);
      }
      if (ripples.length > MAX_RIPPLES) ripples.splice(0, ripples.length - MAX_RIPPLES);
    };

    const drawTrail = (now: number) => {
      paint.clearRect(0, 0, innerWidth, innerHeight);
      if (!ripples.length) return;
      // Couleur relue à chaque image : elle suit le thème.
      paint.strokeStyle = getComputedStyle(dot).backgroundColor;
      for (let i = ripples.length - 1; i >= 0; i--) {
        const wave = ripples[i];
        const age = (now - wave.born) / wave.life;
        if (age >= 1) {
          ripples.splice(i, 1);
          continue;
        }
        for (const { scale, fade } of RINGS) {
          const { radius, alpha, width } = rippleAt(age, wave.max * scale);
          paint.globalAlpha = alpha * fade;
          paint.lineWidth = width;
          paint.beginPath();
          paint.arc(wave.x, wave.y, radius, 0, Math.PI * 2);
          paint.stroke();
        }
      }
      paint.globalAlpha = 1;
    };

    let x = 0;
    let y = 0;
    let ringX = 0;
    let ringY = 0;
    let frame = 0;

    // La boucle ne tourne que tant que l'anneau n'a pas rejoint le point ou qu'il reste des ondulations.
    const render = (now: number) => {
      const follow = reduced.matches ? 1 : 0.2;
      ringX += (x - ringX) * follow;
      ringY += (y - ringY) * follow;
      dot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0)`;
      drawTrail(now);
      frame = Math.abs(x - ringX) + Math.abs(y - ringY) > 0.1 || ripples.length ? requestAnimationFrame(render) : 0;
    };

    addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
        const target = event.target as Element;
        if (target.closest?.(NATIVE)) {
          root.removeAttribute('data-visible');
          trailX = NaN;
          return;
        }
        if (!root.hasAttribute('data-visible')) {
          ringX = event.clientX;
          ringY = event.clientY;
          root.setAttribute('data-visible', '');
        }
        x = event.clientX;
        y = event.clientY;
        // data-shark-hover : posé par le requin de l'accueil, qui se laisse cliquer.
        root.toggleAttribute('data-hover', !!target.closest?.(CLICKABLE) || html.hasAttribute('data-shark-hover'));
        lay(x, y);
        if (!frame) frame = requestAnimationFrame(render);
      },
      { passive: true },
    );

    // Au clic, une ondulation plus large.
    addEventListener(
      'pointerdown',
      (event) => {
        if (reduced.matches) return;
        if (event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
        if ((event.target as Element).closest?.(NATIVE)) return;
        ripple(event.clientX, event.clientY, 72, 1100);
        if (!frame) frame = requestAnimationFrame(render);
      },
      { passive: true },
    );

    // L'iframe capte la souris : le parent ne reçoit plus que l'entrée sur l'iframe.
    addEventListener('pointerover', (event) => {
      if ((event.target as Element).closest?.(NATIVE)) {
        root.removeAttribute('data-visible');
        trailX = NaN;
      }
    });
    html.addEventListener('pointerleave', () => {
      root.removeAttribute('data-visible');
      trailX = NaN;
    });
  }
</script>
