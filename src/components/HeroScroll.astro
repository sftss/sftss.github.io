---
import baskets from '../data/baskets.json';
import type { Lang } from '../i18n/ui';
import HeroText from './HeroText.astro';

const { lang } = Astro.props as { lang: Lang };
const steps =
  lang === 'fr'
    ? ['Des données brutes.', 'Rangées.', 'Qui racontent quelque chose.']
    : ['Raw data.', 'Put in order.', 'Telling a story.'];
const caption =
  lang === 'fr'
    ? 'Paniers du projet MLxtend par mois, de déc. 2010 à déc. 2011.'
    : 'Baskets from the MLxtend project by month, Dec. 2010 to Dec. 2011.';
---

<section class="hero container">
  <HeroText lang={lang} />
</section>

<section class="story" data-story>
  <div class="sticky">
    <p class="step" aria-live="polite">{steps[0]}</p>
    <canvas width="1000" height="520" aria-hidden="true"></canvas>
    <p class="caption">{caption}</p>
  </div>
  <script type="application/json" data-steps set:html={JSON.stringify(steps)} />
  <script type="application/json" data-baskets set:html={JSON.stringify(baskets)} />
</section>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-l);
  }

  .story {
    position: relative;
    height: 260vh;
  }

  .sticky {
    position: sticky;
    top: 0;
    display: grid;
    align-content: center;
    gap: var(--space-s);
    width: min(100% - 2 * var(--space-m), var(--width));
    height: 100svh;
    margin-inline: auto;
  }

  .step {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 700;
  }

  canvas {
    width: 100%;
    height: auto;
    color: var(--color-accent);
  }

  .caption {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-story]');
  if (root) {
    const canvas = root.querySelector('canvas')!;
    const label = root.querySelector('.step')!;
    const steps: string[] = JSON.parse(root.querySelector('[data-steps]')!.textContent!);
    const data = JSON.parse(root.querySelector('[data-baskets]')!.textContent!);
    const ctx = canvas.getContext('2d')!;
    const W = canvas.width;
    const H = canvas.height;
    const months: number[] = data.monthCounts;
    const columns = months.length;
    // Un point vaut le même nombre de paniers dans chaque mois : les colonnes gardent les vraies proportions.
    const perPoint = Math.max(...months) / 600;
    const seed = (i: number) => (Math.sin(i * 12.9898) * 43758.5453) % 1;
    const points = months.flatMap((count, month) =>
      Array.from({ length: Math.round(count / perPoint) }, (_, level) => ({ month, level, index: 0 })),
    );
    points.forEach((point, index) => (point.index = index));
    const colWidth = (W - 40) / columns;
    const ease = (t: number) => t * t * (3 - 2 * t);

    const draw = (progress: number) => {
      ctx.clearRect(0, 0, W, H);
      const t = ease(Math.min(1, Math.max(0, (progress - 0.15) / 0.7)));
      // Le canvas ne comprend pas light-dark() : on lit les couleurs déjà résolues par le navigateur.
      ctx.fillStyle = getComputedStyle(canvas).color;
      for (const p of points) {
        const rx = Math.abs(seed(p.index + 1)) * W;
        const ry = Math.abs(seed(p.index + 7)) * H;
        const col = p.level % 6;
        const row = Math.floor(p.level / 6);
        const bx = 20 + p.month * colWidth + 8 + col * ((colWidth - 16) / 6);
        const by = H - 30 - row * 4.2;
        ctx.fillRect(rx + (bx - rx) * t, ry + (by - ry) * t, 3, 3);
      }
      if (t > 0.98) {
        ctx.fillStyle = getComputedStyle(root.querySelector('.caption')!).color;
        ctx.font = '13px monospace';
        ['D', 'J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'].forEach((m, i) =>
          ctx.fillText(m, 20 + i * colWidth + colWidth / 2 - 4, H - 8),
        );
      }
      label.textContent = steps[progress < 0.3 ? 0 : progress < 0.75 ? 1 : 2];
    };

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      draw(1);
    } else {
      let queued = false;
      const update = () => {
        queued = false;
        const box = root.getBoundingClientRect();
        const progress = Math.min(1, Math.max(0, -box.top / (box.height - innerHeight)));
        draw(progress);
      };
      addEventListener('scroll', () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      update();
    }
  }
</script>
