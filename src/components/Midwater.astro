---
// Accueil, sous la surface : neige marine dès les compétences, méduses dans les marges des
// sections du milieu, plancton bioluminescent à partir de l'expérience. Un seul canvas fixe.
---

<canvas class="midwater" aria-hidden="true" data-midwater></canvas>

<style>
  .midwater {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    font-family: var(--font-mono);
  }
</style>

<script>
  import { onPage } from '../lib/lifecycle';
  import { Midwater } from '../lib/midwater';

  /** Résout une variable de thème (light-dark) en couleur calculée. */
  const resolve = (el: HTMLElement, name: string) => {
    el.style.color = `var(${name})`;
    const color = getComputedStyle(el).color;
    el.style.color = '';
    return color;
  };

  onPage(() => {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-midwater]');
    const byId = (id: string) => document.getElementById(id);
    const snow = byId('skills');
    const jellyFrom = byId('projects');
    const jellyTo = byId('about');
    const plankton = byId('experience');
    if (!canvas || !snow || !jellyFrom || !jellyTo || !plankton) return;

    const water = new Midwater(canvas, { snow, jellyFrom, jellyTo, plankton });
    // Le récif occupe le bas de la page : le footer lui laisse de la place sous ses liens.
    document.documentElement.style.setProperty('--reef-room', '6rem');
    const recolor = () =>
      water.setColors({
        snow: resolve(canvas, '--color-text'),
        jelly: resolve(canvas, '--color-jelly'),
        glow: resolve(canvas, '--color-glow'),
        coral: ['--fish-yellow', '--fish-orange', '--fish-red', '--coral-lilac', '--coral-green', '--fish-blue'].map((name) => resolve(canvas, name)),
      });
    recolor();
    const themeWatcher = new MutationObserver(recolor);
    themeWatcher.observe(document.documentElement, { attributeFilter: ['data-theme'] });

    return () => {
      themeWatcher.disconnect();
      document.documentElement.style.removeProperty('--reef-room');
      water.destroy();
    };
  });
</script>
